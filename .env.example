# ==============================================================================
# CONFIGURACIÓN GENERAL DEL NEGOCIO / EMPRESA
# ==============================================================================
NOMBRE_NEGOCIO="Tu Empresa o Marca"
RUBRO="Sector o Giro Comercial (ej. Clínica Dental, Inmobiliaria, Agencia, Consultoría)"
HORARIO_ATENCION="Lunes a Viernes de 9:00 a 18:00 hrs, Sábados de 9:00 a 14:00 hrs"
UBICACION="Ciudad de México, México (o tu ciudad / país)"
METODOS_PAGO="Transferencia bancaria, tarjetas de crédito, débito y esquemas a plazos"
SERVICIOS_PRECIOS="Asesoría personalizada y cotizaciones a la medida"
TELEFONO_HUMANO="+52 55 0000 0000"

# ==============================================================================
# ASESORES Y DIRECCIÓN (NOTIFICACIONES DE LEADS Y COPILOTO POR WHATSAPP)
# Números de WhatsApp autorizados para recibir alertas y hablar con el copiloto
# Formato: 10 dígitos locales (sin símbolos ni espacios) separados por comas
# ==============================================================================
TELEFONOS_ASESORES="5500000001,5500000002"

# ==============================================================================
# SEGURIDAD Y ACCESO AL PANEL CRM WEB
# ==============================================================================
CRM_PORT=3090
CRM_PASSWORD="CambiaEstaPasswordPorUnaSegura2026"

# ==============================================================================
# INTELIGENCIA ARTIFICIAL (GOOGLE GEMINI)
# Obtén tu clave gratuita en: https://aistudio.google.com/
# ==============================================================================
AI_PROVIDER="gemini"
GEMINI_API_KEY="AIzaSy...Tu_Google_AI_Studio_Key_Aqui"

# ==============================================================================
# INTEGRACIÓN GOOGLE CALENDAR (APPS SCRIPT WEBHOOK)
# Pega la URL del Webhook creado en Google Apps Script para agendar citas
# ==============================================================================
GOOGLE_CALENDAR_WEBHOOK_URL="https://script.google.com/macros/s/AKfycb.../exec"
CALENDAR_WEBHOOK_SECRET="TuSecretKeySegura2026"

# Correos electrónicos que recibirán copia/invitación de cada cita agendada
REPORT_EMAILS="director@tuempresa.com,ventas@tuempresa.com"

# ==============================================================================
# SIMULACIÓN HUMANA Y VELOCIDAD DE RESPUESTA
# ==============================================================================
DELAY_MIN_MS=2000
DELAY_MAX_MS=4500

# ==============================================================================
# REDES SOCIALES Y ENLACES PÚBLICOS (OPCIONAL)
